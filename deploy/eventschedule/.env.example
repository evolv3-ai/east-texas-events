# Settings for the Event Schedule stack on e-tex.events.
#
# Do not edit this file with real values. Run ./init-env.sh, which copies it to .env (ignored by
# git, mode 600) and fills in the three generated secrets. Then edit .env for the settings marked
# REQUIRED. After changing .env, apply it with: docker compose up -d
#
# Both Docker Compose and the app read this file, so keep it to plain KEY=value lines: no spaces
# around "=", and quote a value only if it contains spaces.

# ---------------------------------------------------------------------------------------------
# Site address
# ---------------------------------------------------------------------------------------------

# REQUIRED. What the proxy answers on. A bare hostname gets a Let's Encrypt certificate and an
# HTTP->HTTPS redirect automatically. For a local run use ":80" (plain HTTP, any hostname).
SITE_ADDRESS=e-tex.events

# REQUIRED. The public address, with scheme and no trailing slash. Every link, feed and email the
# app generates is built from it.
APP_URL=https://e-tex.events

# Host ports the proxy publishes. Leave as they are on the server. For a local run on loopback
# use for example 127.0.0.1:18480 and 127.0.0.1:18443.
PROXY_HTTP_BIND=80
PROXY_HTTPS_BIND=443

# REQUIRED. Addresses allowed to tell the proxy who the real visitor is. These are Cloudflare's
# published ranges (https://www.cloudflare.com/ips/, copied 2026-10-07). Check that page when
# upgrading; a missing range makes visitors behind it share one rate limit, nothing worse.
# For a local run without Cloudflare use 127.0.0.1/32.
EDGE_TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

# ---------------------------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------------------------

# Shown in page titles and emails.
APP_NAME="East Texas Events"

# "production" makes every generated link https:// and is required on the server. Use "local"
# only for a plain-HTTP run on your own machine.
APP_ENV=production

# Never true on the server: debug pages show settings and secrets to visitors.
APP_DEBUG=false

# GENERATED by init-env.sh. Encrypts sessions and stored secrets. Keep a copy in the secret
# store: a backup restored under a different key cannot be read. Never change it on a live site.
APP_KEY=

# Stored times are UTC; each schedule has its own display timezone (America/Chicago).
APP_TIMEZONE=UTC

# Trust the forwarding headers from the proxy container. "*" is safe here because the app is
# reachable only from that container, which overwrites those headers on every request. Without
# it the app treats every request as plain HTTP and rate-limits all visitors as one address.
TRUSTED_PROXIES=*

# Session cookie is sent over HTTPS only. Set to false only together with APP_ENV=local.
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=file
SESSION_ENCRYPT=true

# Single-tenant, path-routed install: one domain, schedules at e-tex.events/<path>.
IS_HOSTED=false

# The first account created is the only account. Leave false; see README.md "Admin account".
ALLOW_REGISTRATION=false

# Do not send crash reports to the Event Schedule developers.
REPORT_ERRORS=false

# One log file per day under the storage volume, kept for 14 days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------------------------
# Database (the db service in docker-compose.yml)
# ---------------------------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_DATABASE=eventschedule
DB_USERNAME=eventschedule

# GENERATED by init-env.sh. MariaDB reads both only when it first creates the data volume;
# changing them here later does not change the passwords inside the database.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------------------------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------------------------

# REQUIRED before launch. "log" writes every message into the app log and delivers nothing, so
# password-reset emails go nowhere. For real delivery set MAIL_MAILER=smtp and fill in the rest
# from the mail provider. MAIL_PASSWORD is a secret: set it in .env on the server only.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
# The address mail is sent from. It must be on a domain the mail provider may send for. It has
# to be set even while MAIL_MAILER=log, or the app logs a warning for every message it builds.
MAIL_FROM_ADDRESS=no-reply@e-tex.events
MAIL_FROM_NAME="East Texas Events"

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------

# Only needed for Event Schedule's AI import and daily Auto Import. Leave empty until that pilot
# starts. A secret: set it in .env on the server only.
GEMINI_API_KEY=
AI_TEXT_PROVIDER=gemini

# backup.sh: where archives go on the server and how many days to keep them.
BACKUP_DIR=/var/backups/etex-eventschedule
BACKUP_KEEP_DAYS=14
