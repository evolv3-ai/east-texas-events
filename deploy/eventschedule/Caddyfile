# Reverse proxy for the Event Schedule stack. Values in {$...} come from .env through
# docker-compose.yml.
{
	servers {
		# Cloudflare sits in front of this host. Only requests arriving from these ranges may say
		# who the real visitor is; from anyone else the connecting address is used, so a visitor
		# who reaches the server directly cannot forge an identity.
		trusted_proxies static {$EDGE_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

# A bare hostname (e-tex.events) gets a Let's Encrypt certificate and an HTTP->HTTPS redirect
# automatically. A plain-HTTP address such as ":80" turns both off, for local runs.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Event Schedule sends "/" to its login page. Visitors should land on the calendar.
	redir / /calendar 302

	# Publish only the four generated files, atomically selected by the current symlink.
	# Missing files must not fall through to Event Schedule's product documentation.
	@agent_files path /llms.txt /events.json /openapi.json /sitemap-index.xml
	handle @agent_files {
		root * /srv/static/current
		header Access-Control-Allow-Origin *
		header Cache-Control "public, no-cache, max-age=0, must-revalidate"
		file_server
	}
	# Do not expose the app's unrelated llms-full.txt.
	handle /llms-full.txt {
		respond "Not Found" 404
	}

	handle {
		reverse_proxy web:80 {
			# One address, the real visitor's, in every header the app reads. The app rate-limits
			# per address and reads CF-Connecting-IP without checking who sent it, so both are
			# set here from the address Caddy has already validated against trusted_proxies.
			header_up X-Forwarded-For {client_ip}
			header_up CF-Connecting-IP {client_ip}
			# Do not advertise the nginx and PHP versions.
			header_down -Server
			header_down -X-Powered-By
		}
	}
}
